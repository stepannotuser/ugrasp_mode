//randseq_example.dot

digraph FSM {
    
    subgraph IDLE_g {
        style=filled;
        color=lightgray;
        label="IDLE State";

        node [shape=rectangle];
        IDLE ;
        node [shape=diamond];
        IDLE_sel;
        node [shape=ellipse];
        IDLE_act ;
        IDLE -> IDLE_act -> IDLE_sel;
        
    }

    subgraph A_g {
        style=filled;
        color=lightgray;
        label="A State";

        node [shape=rectangle];
        A;
        node [shape=diamond];
        A_sel;
        node [shape=ellipse];
        A_act;
        A -> A_act -> A_sel;
    }


    subgraph B_g {
        style=filled;
        color=lightgray;
        label="B State";
        node [shape=rectangle];
        B;
        node [shape=diamond];
        B_sel;
        node [shape=ellipse];
        B_act;
        B -> B_act -> B_sel;
        
    }

    subgraph C_g {
        style=filled;
        color=lightgray;
        label="C State";
        node [shape=rectangle];
        C;
        node [shape=diamond];
        C_sel;
        node [shape=ellipse];
        C_act;
        C -> C_act -> C_sel;
    }

    subgraph D_g {
        style=filled;
        color=lightgray;
        label="D State";
        node [shape=rectangle];
        D;
        node [shape=diamond];
        D_sel;
        node [shape=ellipse];
        D_act;
        D -> D_act -> D_sel;
    }

    // --selections--
    node [shape=ellipse];    
    A_sel -> {A_to_A A_to_B A_to_C};
    B_sel -> {B_to_B B_to_C B_to_D};
    IDLE_sel -> {IDLE_to_A IDLE_to_B};
    C_sel    -> {C_to_A C_to_IDLE };
    D_sel    -> {D_to_B D_to_IDLE };

    // target 
    node [shape=ellipse];
    IDLE_to_A -> A;
    IDLE_to_B -> B;
    A_to_A -> A;
    A_to_B -> B;
    A_to_C -> C;
    B_to_B -> B;
    B_to_C -> C;
    B_to_D -> D;
    C_to_A -> A;
    C_to_IDLE -> IDLE;
    D_to_B -> B;
    D_to_IDLE -> IDLE;

}
